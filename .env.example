# Copy file này thành .env rồi điền. KHÔNG BAO GIỜ commit file .env lên GitHub.
# Chỉ dùng ví mới tạo để thử nghiệm, không dùng ví có tiền thật.

# Khóa riêng (private key) của ví EVM dạng 0x... (xuất từ MetaMask, ví thử nghiệm)
PRIVATE_KEY=

# Địa chỉ RPC testnet Portaldot (có thể đổi nếu ban tổ chức cập nhật)
PORTALDOT_RPC_URL=https://test-evm-rpc-v3.portaldot.dev

# Độ dài cửa sổ phán quyết khi deploy, tính bằng giây (mặc định 60 để demo nhanh, thật nên để 86400 = 24 giờ)
RESOLUTION_WINDOW=60
