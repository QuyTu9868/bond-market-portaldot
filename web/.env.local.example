# Copy file này thành .env.local rồi điền. Không chứa khóa bí mật, chỉ có địa chỉ công khai.

# local = mạng ảo Hardhat (npm run node), testnet = Portaldot V3
NEXT_PUBLIC_NETWORK=local

# Địa chỉ contract PredictionMarket, lấy từ deployments/<mạng>-market.json (field address)
# Mạng ảo, lần deploy đầu tiên thường ra: 0x5FbDB2315678afecb367f032d93F642f64180aa3
NEXT_PUBLIC_MARKET_ADDRESS=0x5FbDB2315678afecb367f032d93F642f64180aa3

# Tiền tố link xem giao dịch, có thể để trống nếu chưa có explorer cho EVM
NEXT_PUBLIC_EXPLORER_TX_URL=
